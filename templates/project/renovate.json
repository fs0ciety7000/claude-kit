{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", "helpers:pinGitHubActionDigests"],
  "pinDigests": true,
  "minimumReleaseAge": "3 days",
  "timezone": "Europe/Brussels",
  "schedule": ["after 9am and before 6pm every weekday"],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": { "labels": ["security"], "minimumReleaseAge": null, "schedule": ["at any time"] },
  "customManagers": [
    {
      "description": "Forgejo Actions from data.forgejo.org pinned by SHA, version in the trailing comment (kit project ci)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.forgejo/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s*[\"']?https://data\\.forgejo\\.org/(?<depName>actions/[A-Za-z0-9._-]+)@(?<currentDigest>[0-9a-f]{40})[\"']?\\s+#\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "The same data.forgejo.org actions are updated by the custom manager above, not twice by github-actions",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["/^https://data\\.forgejo\\.org//"],
      "enabled": false
    },
    {
      "description": "Patches and digests: merged automatically once CI is green",
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Majors are always reviewed",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "majeure"]
    },
    {
      "description": "Never a major of a database engine: it needs a dump and a restore",
      "matchPackageNames": ["postgres", "/postgres/", "redis", "valkey/valkey", "mysql", "mariadb", "mongo"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
