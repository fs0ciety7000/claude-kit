{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh repo view*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(pnpm install*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo check*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(go build*)",
      "Bash(go test*)",
      "Bash(go vet*)",
      "Bash(go fmt*)",
      "Bash(go mod *)",
      "Bash(gofmt*)",
      "Bash(godot --headless*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(tree*)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(kit add-skill*)",
      "Bash(kit add-agent*)",
      "Bash(kit new-agent*)",
      "Bash(kit new-skill*)",
      "Bash(kit list*)",
      "Bash(kit skills *)",
      "Bash(kit registry*)",
      "Bash(kit project *)",
      "Bash(kit doctor*)",
      "Bash(kit secrets list*)",
      "Bash(kit secrets check*)",
      "Bash(kit secrets doctor*)",
      "Bash(kit api coolify /*)",
      "Bash(kit api coolify \"/*)",
      "Bash(kit api coolify GET *)",
      "Bash(kit api cloudflare /*)",
      "Bash(kit api cloudflare \"/*)",
      "Bash(kit api cloudflare GET *)",
      "Bash(kit secrets run -- wrangler *)",
      "Bash(kit secrets run * -- wrangler *)",
      "Bash(kit secrets run -- npx wrangler *)",
      "Bash(kit secrets run * -- npx wrangler *)",
      "Bash(kit api coolify POST *)",
      "Bash(kit api coolify PUT *)",
      "Bash(kit api coolify PATCH *)",
      "Bash(kit api coolify TRIGGER *)",
      "Bash(kit api cloudflare POST *)",
      "Bash(kit api cloudflare PUT *)",
      "Bash(kit api cloudflare PATCH *)",
      "Bash(kit api cloudflare TRIGGER *)",
      "Bash(kit api github /*)",
      "Bash(kit api github \"/*)",
      "Bash(kit api github GET *)",
      "Bash(kit api github POST *)",
      "Bash(kit api github PUT *)",
      "Bash(kit api github PATCH *)",
      "Bash(kit repo create *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git push * --delete *)",
      "Bash(git push origin :*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh repo edit * --visibility *)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler delete*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler publish*)",
      "Bash(*wrangler login*)",
      "Bash(*wrangler r2 *)",
      "Bash(*wrangler d1 *)",
      "Bash(*wrangler kv*)",
      "Bash(kit secrets add*)",
      "Bash(kit secrets rm*)",
      "Bash(kit secrets add-recipient*)",
      "Bash(rm *)",
      "Bash(docker *)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.config/claude-kit/secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(sudo *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(sops -d*)",
      "Bash(sops --decrypt*)",
      "Bash(sops decrypt*)",
      "Bash(sops exec-env*)",
      "Bash(sops exec-file*)",
      "Bash(age *)",
      "Bash(age-keygen*)",
      "Bash(kit secrets edit*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(kit api * DELETE *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/claude-kit/hooks/guard-secrets.sh"
          }
        ]
      }
    ]
  }
}
